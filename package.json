{
  "name": "wazobiamail-nextjs",
  "version": "0.1.1",
  "description": "Official Next.js App Router, Pages Router, Server Actions, React Email, and Webhook SDK for WazobiaMail",
  "keywords": [
    "wazobiamail",
    "nextjs",
    "next",
    "react",
    "react-email",
    "app-router",
    "server-actions",
    "webhooks",
    "email",
    "sdk",
    "typescript"
  ],
  "homepage": "https://wazobiamail.com",
  "bugs": "https://github.com/WazobiaMail/wazobiamail-nextjs/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/WazobiaMail/wazobiamail-nextjs.git"
  },
  "license": "MIT",
  "author": "Bowofade Oyerinde <info@bonifadetechnologies.com> (https://github.com/WazobiaMail)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      },
      "default": "./dist/client.js"
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      },
      "default": "./dist/server.js"
    },
    "./webhooks": {
      "import": {
        "types": "./dist/webhooks.d.ts",
        "default": "./dist/webhooks.js"
      },
      "require": {
        "types": "./dist/webhooks.d.cts",
        "default": "./dist/webhooks.cjs"
      },
      "default": "./dist/webhooks.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build && bun test"
  },
  "dependencies": {
    "wazobiamail": "^0.1.1",
    "wazobiamail-react": "^0.1.1"
  },
  "peerDependencies": {
    "@react-email/render": ">=0.0.10",
    "next": "^14.0.0 || ^15.0.0 || ^16.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@react-email/render": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.2"
  }
}
